{
  "name": "pokopia-wiki",
  "version": "1.0.0",
  "private": true,
  "description": "A bilingual (EN/TH) fan wiki for Pokémon Pokopia — static site, zero runtime dependencies.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "sprites": "node scripts/sprites.mjs",
    "data": "node scripts/shape.mjs",
    "build": "node scripts/sprites.mjs && node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs"
  },
  "license": "MIT"
}
